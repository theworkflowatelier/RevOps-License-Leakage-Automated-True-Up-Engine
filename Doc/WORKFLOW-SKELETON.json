      "name": "Node #2 - SHEETS : Read RAW_USAGE_DB"
    },
    {
      "parameters": {
        "jsCode": "const usageData = $input.all(); \nlet trueUpQueue = [];\nfor (let item of usageData) {\n    let usage = item.json;\n    let contractedSeats = 10; // Baseline contracted seats\n    let actualSeats = parseInt(usage.ACTIVE_SEATS);\n    \n    if (actualSeats > contractedSeats) {\n        let overage = actualSeats - contractedSeats;\n        let lostRevenue = overage * 50; \n        \n        trueUpQueue.push({\n            COMPANY_ID: usage.COMPANY_ID,\n            COMPANY_NAME: usage.COMPANY_NAME,\n            CONTRACTED_SEATS: contractedSeats,\n            ACTUAL_SEATS: actualSeats,\n            OVERAGE_DELTA: overage,\n            LEAKAGE_USD: lostRevenue\n        });\n    }\n}\nreturn trueUpQueue.map(entry => ({ json: entry }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        32,
        208
      ],
